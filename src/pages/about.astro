---
import SiteFooter from '../components/astro/SiteFooter.astro';
import SiteHeader from '../components/astro/SiteHeader.astro';
import AboutSection from '../components/astro/sections/AboutSection.astro';
import { t } from '../i18n/t';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "MegaBarto's Portfolio | About";
const description = t('autobiography.introduction');
---

<BaseLayout title={title} description={description}>
  <div class="app">
    <SiteHeader />
    <main class="main-content page-detail">
      <AboutSection />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

{
  "name": "megabarto.com",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "render:cv": "node scripts/render-cv.mjs",
    "sync:texts": "node scripts/sync-texts.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify": "bun run lint && bun run check && bun run verify:i18n && bun run build",
    "lighthouse": "lhci autorun",
    "verify:lighthouse": "bun run build && bun run lighthouse",
    "predeploy": "bun run verify",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "gh-pages": "^6.3.0",
    "nanostores": "^1.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/sitemap": "^3.7.2",
    "@biomejs/biome": "^2.4.12",
    "@lhci/cli": "^0.15.1",
    "astro": "^6.1.8",
    "lightningcss": "^1.33.0",
    "typescript": "~5.8.3",
    "yaml": "^2.9.1"
  }
}
